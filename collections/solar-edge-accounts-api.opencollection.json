{
  "opencollection": "1.0.0",
  "info": {
    "name": "SolarEdge Monitoring Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Account List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://monitoringapi.solaredge.com/accounts/list",
            "params": [
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of accounts per page (max 100)"
              },
              {
                "name": "startIndex",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              },
              {
                "name": "searchText",
                "value": "",
                "type": "query",
                "description": "Text to search across account fields"
              },
              {
                "name": "sortProperty",
                "value": "",
                "type": "query",
                "description": "Property to sort results by"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query",
                "description": "Sort order"
              }
            ]
          },
          "docs": "Returns the account details and list of sub-accounts for the provided API key."
        }
      ]
    }
  ],
  "bundled": true
}